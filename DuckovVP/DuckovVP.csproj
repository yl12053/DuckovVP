<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <IsMac>false</IsMac>
        <IsMac Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))'">true</IsMac>

        <!-- DuckovPath 优先级 (Priority):
             1. 环境变量 $(DUCKOV_PATH)（最优先，适合 CI / 多机器场景）
             2. 用户自定义 props 文件 $(DuckovUserProps) 中的 DuckovPath
             3. 本文件内硬编码路径（兜底） -->
        <DuckovPath Condition="'$(DuckovPath)' == '' AND '$(DUCKOV_PATH)' != ''">$(DUCKOV_PATH)</DuckovPath>
        <DuckovPath Condition="'$(DuckovPath)' == '' AND '$(IsMac)' != 'true'">E:\SteamLibrary\steamapps\common\Escape from Duckov</DuckovPath>

        <!-- For Mac users, please fill the folder path which contains Duckov.app below -->
        <!-- Mac 用户请在下面这行填写你的鸭科夫安装路径（包含 Duckov.app 的目录）-->
        <DuckovPath Condition="'$(DuckovPath)' == '' AND '$(IsMac)'">/Users/Somebody/Library/Application Support/Steam/steamapps/common/Escape from Duckov</DuckovPath>

        <SubPath>\Duckov_Data\Managed\</SubPath>
        <SubPath Condition="'$(IsMac)'">/Duckov.app/Contents/Resources/Data/Managed/</SubPath>
        <LangVersion>12.0</LangVersion>

        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(DuckovPath)$(SubPath)TeamSoda.*">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)ItemStatsSystem.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)Unity*">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)Newtonsoft.Json.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)SodaLocalization.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)ParadoxNotion.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)$(SubPath)UniTask*">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)$(SubPath)Eflatun.SceneReference.dll">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)$(SubPath)Plugins.dll">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)$(SubPath)FMODUnity.dll">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)$(SubPath)EasySave3.dll">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)$(SubPath)LeTai.*.dll">
            <Private>False</Private>
        </Reference>

        <Reference Include="$(DuckovPath)\..\..\workshop\content\3167020\3589088839\0Harmony.dll">
            <Private>False</Private>
        </Reference>
        
        <!-- <Reference Include="$(DuckovPath)\..\..\workshop\content\3167020\3759478942\FeatherMod.dll">
            <Private>False</Private>
        </Reference> -->
        <Reference Include="$(DuckovPath)$(SubPath)\..\Mods\FeatherMod\FeatherMod.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)\..\..\workshop\content\3167020\3595729494\ModSetting.dll">
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Resources\**" />
        <EmbeddedResource Remove="Resources\**" />
        <None Remove="Resources\**" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Remove="Tests\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1">
            <Private>False</Private>
        </PackageReference>
        <PackageReference Include="VideoLan.LibVLC.Mac" Version="3.1.3.1">
            <Private>False</Private>
        </PackageReference>
        <PackageReference Include="LibVLCSharp" Version="3.10.0">
            <Private>False</Private>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <!-- All members in an assembly -->
        <Publicize Include="TeamSoda.Duckov.Core" IncludeVirtualMembers="false" />
        <Publicize Include="SodaLocalization" IncludeVirtualMembers="false" />
        <Publicize Include="TeamSoda.Duckov.Utilities" IncludeVirtualMembers="false" />
        <Publicize Include="ItemStatsSystem" IncludeVirtualMembers="false" />
        <Publicize Include="LibVLCSharp" IncludeVirtualMembers="false" />
        <DoNotPublicize Include="TeamSoda.Duckov.Core:Duckov.MiniGames.GamingConsole.OnGamingConsoleInteractChanged" />
        <DoNotPublicize Include="TeamSoda.Duckov.Core:Duckov.UI.ManagedUIElement.onClose" />
        <DoNotPublicize Include="TeamSoda.Duckov.Core:Duckov.UI.InventoryDisplay.onDisplayDoubleClicked" />
        <DoNotPublicize Include="TeamSoda.Duckov.Core:Duckov.UI.SlotDisplay.onSlotDisplayDoubleClicked" />
        <DoNotPublicize Include="ItemStatsSystem:ItemStatsSystem.Items.Slot.onSlotContentChanged" />
        <DoNotPublicize Include="TeamSoda.Duckov.Core:Duckov.UI.ItemUIUtilities.OnSelectionChanged" />
    </ItemGroup>
</Project>
